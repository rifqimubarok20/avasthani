# =============================================================================
# Avasthani - Environment configuration (development)
# =============================================================================
# Salin file ini menjadi .env dan isi nilai dari Firebase Console
# (Project settings -> Your apps -> pilih app Android/iOS -> Config).
# Jangan meng-commit file .env yang berisi nilai aktual ke repository.

# Firebase client config (publik, untuk SDK klien React Native Firebase)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# OAuth Web client ID (client_type 3 dari google-services.json/Firebase Console).
EXPO_PUBLIC_FIREBASE_WEB_CLIENT_ID=

# Path file google-services.json (Android) untuk build development/production.
# Disiapkan oleh developer saat membangun natively; tidak ada kredensial rahasia
# yang disimpan dalam bundle aplikasi.
GOOGLE_SERVICES_JSON=google-services.json
# Untuk iOS, unduh GoogleService-Info.plist dari Firebase Console.
GOOGLE_SERVICES_IOS_FILE=GoogleService-Info.plist
# Google Maps SDK for Android key. Restrict its API to Maps SDK for Android,
# and its Android app restriction to com.avasthani.app + the signing SHA-1.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
# Optional Google Maps iOS SDK key; the current farm picker uses native Apple MapKit,
# so this Google key is not required for that screen.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=

# Region Cloud Functions. Harus sama dengan region di functions/src/ai/recommend.ts.
EXPO_PUBLIC_FUNCTIONS_REGION=asia-southeast2

# Catatan: API key provider AI (Groq/Gemini/dll) TIDAK boleh ditaruh di sini.
# Key disimpan sebagai secret Cloud Function:
#   firebase functions:secrets:set GROQ_API_KEY
